<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background"
    tools:context=".MainActivity">

    <!-- WebSocket Connection Status Bar -->
    <View
        android:id="@+id/webSocketStatusIndicator"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_gravity="top"
        android:background="@color/ws_status_connecting"
        android:contentDescription="@string/cd_ws_status_connecting"
        android:importantForAccessibility="yes" />

    <!-- Scrollable main content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="32dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mainContentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <EditText
                android:id="@+id/editTextNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_enter_number"
                android:inputType="number"
                android:importantForAutofill="no"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/buttonWriteNfc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_write_nfc"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/buttonReadNfc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/success_green"
                android:textColor="@color/white"
                android:text="@string/button_start_scanning"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/buttonCheckInNfc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_check_in"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/buttonCheckOutNfc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_check_out"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/buttonClearScans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_clear_scans"
                android:textColor="@color/white"
                android:backgroundTint="@color/error_red"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/buttonResetGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_reset_game"
                android:textColor="@color/white"
                android:backgroundTint="@color/error_red"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:id="@+id/textViewStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_idle"
                android:textSize="18sp"
                android:gravity="center"
                android:padding="8dp"/>

            <Button
                android:id="@+id/buttonSettings"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_settings"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Scanning Bar -->
    <View
        android:id="@+id/scanningBar"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:background="@color/error_red"
        android:contentDescription="@string/cd_scanning_bar"
        android:visibility="gone" />

    <!-- Success Number Display -->
    <TextView
        android:id="@+id/textViewSuccessNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="190sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:fontFamily="@font/socafe"
        android:importantForAccessibility="yes"
        android:visibility="gone" />

</FrameLayout>
