<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_background"
    tools:context=".MainActivity">

    <!-- WebSocket Connection Status Bar -->
    <View
        android:id="@+id/webSocketStatusIndicator"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_gravity="top"
        android:background="@color/ws_status_connecting" />


    <!-- Main content area -->
    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <EditText
            android:id="@+id/editTextNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter number (1-100) to write"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/buttonWriteNfc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WRITE to NFC"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonReadNfc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/success_green"
            android:textColor="@color/white"
            android:text="Start Scanning"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/buttonCheckInNfc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check IN Card"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonCheckOutNfc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check OUT Card"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/buttonClearScans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear scans"
            android:textColor="@color/white"
            android:backgroundTint="@color/error_red"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonResetGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Game"
            android:textColor="@color/white"
            android:backgroundTint="@color/error_red"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:id="@+id/textViewStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Idle"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Scanning Animation (ProgressBar - will be hidden for the new animation) -->
    <ProgressBar
        android:id="@+id/progressBarScanning"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- New Scanning Bar -->
    <View
        android:id="@+id/scanningBar"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:background="@color/error_red"
        android:visibility="gone" /> <!-- Initially hidden -->

    <!-- Success Number Display -->
    <TextView
        android:id="@+id/textViewSuccessNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="190sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:fontFamily="@font/socafe"
        android:visibility="gone" /> <!-- Initially hidden -->

</FrameLayout>