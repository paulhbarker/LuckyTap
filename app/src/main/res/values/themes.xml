<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LuckyTap" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_green_muted</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/secondary_blue</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/tertiary_amber</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_medium_dark</item>
        <item name="colorOutline">@color/outline_dark</item>

        <!-- Error -->
        <item name="colorError">@color/error_red</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
    </style>

    <!-- Connection status card -->
    <style name="Widget.NFCApp.ConnectionCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_variant_dark</item>
        <item name="strokeColor">@color/outline_dark</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Primary action button (Start Scanning) -->
    <style name="Widget.NFCApp.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Secondary action buttons (Check In/Out) -->
    <style name="Widget.NFCApp.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/surface_variant_dark</item>
        <item name="android:textColor">@color/on_surface_dark</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Destructive buttons (Clear/Reset) -->
    <style name="Widget.NFCApp.Button.Destructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/error_red</item>
        <item name="strokeColor">@color/button_destructive_stroke</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Text button (Settings) -->
    <style name="Widget.NFCApp.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/on_surface_medium_dark</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Write button -->
    <style name="Widget.NFCApp.Button.Write" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/surface_variant_dark</item>
        <item name="android:textColor">@color/secondary_blue</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Section header text -->
    <style name="TextAppearance.NFCApp.SectionHeader" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/on_surface_dim_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

</resources>
